// ====================================================================
// HOSPITAL OPERATIONS INTELLIGENCE DASHBOARD - DAX MEASURES
// ====================================================================

// --------------------------------------------------------------------
// 1. EXECUTIVE & OPERATIONAL VOLUME MEASURES
// --------------------------------------------------------------------

Total Admissions = 
COUNTROWS('Admissions')

Total Patients = 
DISTINCTCOUNT('Admissions'[Patient_ID])

Total Emergency Cases = 
CALCULATE(
    COUNTROWS('Admissions'),
    'Admissions'[Admission_Type] = "Emergency"
)

Total Inpatient Cases = 
CALCULATE(
    COUNTROWS('Admissions'),
    'Admissions'[Admission_Type] = "Inpatient"
)

Total Outpatient Cases = 
CALCULATE(
    COUNTROWS('Admissions'),
    'Admissions'[Admission_Type] = "Outpatient"
)

Emergency Ratio % = 
DIVIDE(
    [Total Emergency Cases],
    [Total Admissions],
    0
)

Inpatient Ratio % = 
DIVIDE(
    [Total Inpatient Cases],
    [Total Admissions],
    0
)

Outpatient Ratio % = 
DIVIDE(
    [Total Outpatient Cases],
    [Total Admissions],
    0
)

// --------------------------------------------------------------------
// 2. CAPACITY & EFFICIENCY MEASURES (ALOS & WAIT TIME)
// --------------------------------------------------------------------

Average Length of Stay (Days) = 
AVERAGEX(
    'Admissions',
    DATEDIFF('Admissions'[Admission_Date], 'Admissions'[Discharge_Date], DAY)
)

Average Waiting Time (Mins) = 
AVERAGE('Admissions'[Waiting_Time_Minutes])

Emergency Avg Wait Time = 
CALCULATE(
    AVERAGE('Admissions'[Waiting_Time_Minutes]),
    'Admissions'[Admission_Type] = "Emergency"
)

Readmission Count = 
CALCULATE(
    COUNTROWS('Admissions'),
    'Admissions'[Readmission] = "Yes"
)

Readmission Rate % = 
DIVIDE(
    [Readmission Count],
    [Total Admissions],
    0
)

// --------------------------------------------------------------------
// 3. FINANCIAL & REVENUE MEASURES
// --------------------------------------------------------------------

Total Revenue Collected = 
SUM('Billing'[Amount_Paid])

Total Gross Billed = 
SUM('Billing'[Treatment_Cost]) + SUM('Billing'[Medicine_Cost]) + SUM('Billing'[Room_Charges])

Total Treatment Cost = 
SUM('Billing'[Treatment_Cost])

Total Medicine Cost = 
SUM('Billing'[Medicine_Cost])

Total Room Charges = 
SUM('Billing'[Room_Charges])

Average Bill Per Admission = 
DIVIDE(
    [Total Revenue Collected],
    [Total Admissions],
    0
)

Insured Patients Count = 
CALCULATE(
    COUNTROWS('Billing'),
    'Billing'[Insurance] = "Yes"
)

Insurance Penetration Rate % = 
DIVIDE(
    [Insured Patients Count],
    COUNTROWS('Billing'),
    0
)

Insured Collections = 
CALCULATE(
    SUM('Billing'[Amount_Paid]),
    'Billing'[Insurance] = "Yes"
)

Self-Pay Collections = 
CALCULATE(
    SUM('Billing'[Amount_Paid]),
    'Billing'[Insurance] = "No"
)

// --------------------------------------------------------------------
// 4. CLINICAL OUTCOME & QUALITY MEASURES
// --------------------------------------------------------------------

Total Treatments = 
COUNTROWS('Treatments')

Successful Recoveries = 
CALCULATE(
    COUNTROWS('Treatments'),
    'Treatments'[Outcome] = "Recovered"
)

Treatment Recovery Rate % = 
DIVIDE(
    [Successful Recoveries],
    [Total Treatments],
    0
)

Improved Cases = 
CALCULATE(
    COUNTROWS('Treatments'),
    'Treatments'[Outcome] = "Improved"
)

Improvement Rate % = 
DIVIDE(
    [Improved Cases],
    [Total Treatments],
    0
)

Total Surgeries = 
CALCULATE(
    COUNTROWS('Treatments'),
    'Treatments'[Surgery] = "Yes"
)

Surgery Rate % = 
DIVIDE(
    [Total Surgeries],
    [Total Treatments],
    0
)

Mortality Count = 
CALCULATE(
    COUNTROWS('Treatments'),
    'Treatments'[Outcome] = "Deceased"
)

Mortality Rate % = 
DIVIDE(
    [Mortality Count],
    [Total Treatments],
    0
)

// --------------------------------------------------------------------
// 5. DOCTOR & DEPARTMENT PERFORMANCE MEASURES
// --------------------------------------------------------------------

Total Active Doctors = 
DISTINCTCOUNT('Doctors'[Doctor_ID])

Average Doctor Experience = 
AVERAGE('Doctors'[Experience_Years])

Average Consultation Fee = 
AVERAGE('Doctors'[Consultation_Fee])

Revenue Per Doctor = 
DIVIDE(
    [Total Revenue Collected],
    [Total Active Doctors],
    0
)

Patients Per Doctor = 
DIVIDE(
    [Total Admissions],
    [Total Active Doctors],
    0
)

// --------------------------------------------------------------------
// 6. BED INVENTORY & UTILIZATION MEASURES
// --------------------------------------------------------------------

Total Bed Capacity = 
COUNTROWS('Beds')

Total General Beds = 
CALCULATE(
    COUNTROWS('Beds'),
    'Beds'[Bed_Type] = "General"
)

Total ICU Beds = 
CALCULATE(
    COUNTROWS('Beds'),
    'Beds'[Bed_Type] = "ICU"
)

Total Private Beds = 
CALCULATE(
    COUNTROWS('Beds'),
    'Beds'[Bed_Type] = "Private"
)

Total Semi-Private Beds = 
CALCULATE(
    COUNTROWS('Beds'),
    'Beds'[Bed_Type] = "Semi-Private"
)

// --------------------------------------------------------------------
// 7. PATIENT DEMOGRAPHICS MEASURES
// --------------------------------------------------------------------

Average Patient Age = 
AVERAGE('Patients'[Age])

Male Patients Count = 
CALCULATE(
    COUNTROWS('Patients'),
    'Patients'[Gender] = "Male"
)

Female Patients Count = 
CALCULATE(
    COUNTROWS('Patients'),
    'Patients'[Gender] = "Female"
)
