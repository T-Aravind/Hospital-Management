# Hospital Operations Intelligence Dashboard - Environment Configuration

# Backend Settings
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
DATA_DIR=data

# Optional MySQL Database Connection (When transitioning from CSV to MySQL)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_password
MYSQL_DATABASE=hospital_db
USE_MYSQL=false

# Frontend Settings (Used during Vite build/development)
VITE_API_URL=http://localhost:8000
